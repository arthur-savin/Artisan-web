# Web Artisan - Configuration Apache (Hostinger)
# Index par défaut
DirectoryIndex index.html

# Forcer HTTPS uniquement (éviter chaînes de redirection)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Forcer UTF-8
AddDefaultCharset UTF-8

# Sécurité : désactiver l'affichage des répertoires
Options -Indexes

# Protection des fichiers sensibles (si présents par erreur)
<FilesMatch "\.(env|json|log|sqlite|db)$">
  Require all denied
</FilesMatch>

# Cache navigateur pour les assets (optionnel)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
